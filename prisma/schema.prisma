generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id
  name          String    @db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @db.Text
  banned        Boolean?  @default(false)
  banReason     String?   @db.Text
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.Text
  userAgent      String?  @db.Text
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @db.Text

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String    @db.VarChar(191)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId(length: 191)])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model Company {
  id                String   @id @default(cuid())
  legalName         String   @db.VarChar(255)
  shortName         String?  @db.VarChar(255)
  unifiedCreditCode String?  @db.VarChar(64)
  contactName       String?  @db.VarChar(128)
  phone             String?  @db.VarChar(64)
  email             String?  @db.VarChar(255)
  address           String?  @db.Text
  bankName          String?  @db.VarChar(255)
  bankAccount       String?  @db.VarChar(128)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  purchaseContracts PurchaseContract[]

  @@map("company")
}

model Supplier {
  id                String   @id @default(cuid())
  code              String   @unique @db.VarChar(64)
  legalName         String   @db.VarChar(255)
  shortName         String?  @db.VarChar(255)
  unifiedCreditCode String?  @db.VarChar(64)
  contactName       String?  @db.VarChar(128)
  phone             String?  @db.VarChar(64)
  email             String?  @db.VarChar(255)
  address           String?  @db.Text
  bankName          String?  @db.VarChar(255)
  bankAccount       String?  @db.VarChar(128)
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  purchaseContracts PurchaseContract[]

  @@map("supplier")
}

model Product {
  id            String   @id @default(cuid())
  code          String   @unique @db.VarChar(64)
  name          String   @db.VarChar(255)
  specification String?  @db.VarChar(255)
  unit          String   @db.VarChar(32)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  purchaseContractItems PurchaseContractItem[]

  @@map("product")
}

enum PurchaseContractStatus {
  DRAFT
  FINAL
  CANCELLED
}

model PurchaseContract {
  id                      String                 @id @default(cuid())
  contractNo              String                 @unique @db.VarChar(64)
  status                  PurchaseContractStatus @default(DRAFT)
  signingDate             DateTime               @db.Date
  signingPlace            String?                @db.VarChar(255)
  companyId               String
  supplierId              String
  buyerLegalName          String                 @db.VarChar(255)
  buyerUnifiedCreditCode  String?                @db.VarChar(64)
  buyerContactName        String?                @db.VarChar(128)
  buyerPhone              String?                @db.VarChar(64)
  buyerAddress            String?                @db.Text
  buyerBankName           String?                @db.VarChar(255)
  buyerBankAccount        String?                @db.VarChar(128)
  sellerLegalName         String                 @db.VarChar(255)
  sellerUnifiedCreditCode String?                @db.VarChar(64)
  sellerContactName       String?                @db.VarChar(128)
  sellerPhone             String?                @db.VarChar(64)
  sellerAddress           String?                @db.Text
  sellerBankName          String?                @db.VarChar(255)
  sellerBankAccount       String?                @db.VarChar(128)
  deliveryDate            DateTime?              @db.Date
  deliveryAddress         String?                @db.Text
  deliveryContactName     String?                @db.VarChar(128)
  deliveryContactPhone    String?                @db.VarChar(64)
  packagingTerms          String?                @db.Text
  inspectionTerms         String?                @db.Text
  paymentTerms            String?                @db.Text
  shippingMethod          String?                @db.Text
  breachTerms             String?                @db.Text
  qualityTerms            String?                @db.Text
  changeTerms             String?                @db.Text
  disputeTerms            String?                @db.Text
  additionalTerms         String?                @db.Text
  totalAmount             Decimal                @db.Decimal(18, 2)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  company                 Company                @relation(fields: [companyId], references: [id])
  supplier                Supplier               @relation(fields: [supplierId], references: [id])
  items                   PurchaseContractItem[]

  @@map("purchase_contract")
}

model PurchaseContractItem {
  id                 String           @id @default(cuid())
  purchaseContractId String
  productId          String
  sortOrder          Int              @default(0)
  productCode        String           @db.VarChar(64)
  productName        String           @db.VarChar(255)
  specification      String?          @db.VarChar(255)
  unit               String           @db.VarChar(32)
  quantity           Decimal          @db.Decimal(18, 3)
  unitPrice          Decimal          @db.Decimal(18, 4)
  amount             Decimal          @db.Decimal(18, 2)
  purchaseContract   PurchaseContract @relation(fields: [purchaseContractId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id])

  @@index([purchaseContractId, sortOrder])
  @@map("purchase_contract_item")
}
